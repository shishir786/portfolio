---
import { Mail, MapPin, Send, Copy, Check, Clock, MessageSquare, CircleCheck } from '@lucide/astro';
import Github from './icons/Github.astro';
import Linkedin from './icons/Linkedin.astro';

const directEmail = 'abdullahshishir786@gmail.com';
const inputBase =
  'w-full rounded-lg bg-black/30 border border-white/[0.1] text-white text-sm placeholder-slate-500 focus:outline-none focus:border-blue-500 transition-colors';
const labelCls = 'block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2 font-mono';
---

<section id="contact" class="py-14 md:py-24 border-b border-white/[0.08] relative">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <!-- Left: direct inquiries -->
      <div class="reveal lg:col-span-5 space-y-8">
        <div class="space-y-3">
          <div class="text-xs font-mono uppercase tracking-wider text-blue-400 font-semibold">Get in Touch</div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Let's Discuss Projects &amp; Collaborations.</h2>
          <p class="text-sm text-slate-300 leading-relaxed font-normal">
            Whether you have an upcoming project, engineering role inquiry, or want to discuss backend architectures, my inbox is always open.
          </p>
        </div>

        <div class="space-y-3">
          <div class="p-4 rounded-xl surface-card border border-white/[0.08] flex items-center justify-between gap-3">
            <div class="flex items-center gap-3 overflow-hidden">
              <div class="w-10 h-10 rounded-lg bg-blue-600/10 border border-blue-500/20 flex items-center justify-center shrink-0">
                <Mail class="w-5 h-5 text-blue-400" />
              </div>
              <div class="min-w-0">
                <span class="text-[11px] font-mono uppercase text-slate-400 block">Direct Email</span>
                <a href={`mailto:${directEmail}`} class="text-sm font-semibold text-white hover:text-blue-400 transition-colors truncate block">
                  {directEmail}
                </a>
              </div>
            </div>

            <button
              id="copy-email"
              data-email={directEmail}
              class="p-2 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white transition-colors shrink-0 cursor-pointer flex items-center gap-1.5 text-xs font-medium"
              title="Copy email to clipboard"
            >
              <span class="copy-idle flex items-center gap-1.5">
                <Copy class="w-3.5 h-3.5" />
                <span class="font-mono text-[11px]">Copy</span>
              </span>
              <span class="copy-done hidden items-center gap-1.5">
                <Check class="w-3.5 h-3.5 text-emerald-400" />
                <span class="text-emerald-400 font-mono text-[11px]">Copied</span>
              </span>
            </button>
          </div>

          <div class="p-4 rounded-xl surface-card border border-white/[0.08] flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-blue-600/10 border border-blue-500/20 flex items-center justify-center shrink-0">
              <MapPin class="w-5 h-5 text-blue-400" />
            </div>
            <div>
              <span class="text-[11px] font-mono uppercase text-slate-400 block">Location &amp; Timezone</span>
              <p class="text-sm font-semibold text-white">
                Dhaka, Bangladesh <span class="text-xs font-mono text-slate-400 font-normal">(UTC +6:00)</span>
              </p>
            </div>
          </div>

          <div class="p-4 rounded-xl surface-card border border-white/[0.08] flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-blue-600/10 border border-blue-500/20 flex items-center justify-center shrink-0">
              <Clock class="w-5 h-5 text-blue-400" />
            </div>
            <div>
              <span class="text-[11px] font-mono uppercase text-slate-400 block">Response Window</span>
              <p class="text-sm font-semibold text-slate-200">Typically responds within 24 hours</p>
            </div>
          </div>
        </div>

        <div class="pt-2 flex items-center gap-4 text-slate-300">
          <span class="text-xs font-mono uppercase text-slate-400">Profiles:</span>
          <a href="https://github.com/shishir786" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg surface-card border border-white/[0.08] hover:border-blue-400 hover:text-white transition-colors" title="GitHub">
            <Github class="w-4 h-4" />
          </a>
          <a href="https://linkedin.com/in/abdullah-shishir" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg surface-card border border-white/[0.08] hover:border-blue-400 hover:text-white transition-colors" title="LinkedIn">
            <Linkedin class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Right: form -->
      <div class="reveal lg:col-span-7" style="--d: 150ms">
        <div class="p-6 sm:p-8 rounded-2xl surface-card border border-white/[0.08] relative">
          <div class="flex items-center gap-2 text-xs font-mono text-slate-400 uppercase tracking-wider mb-6">
            <MessageSquare class="w-4 h-4 text-blue-400" />
            <span>Send a Direct Message</span>
          </div>

          <div id="form-error" role="alert" hidden class="p-3.5 mb-6 rounded-lg bg-red-500/10 border border-red-500/20 text-xs text-red-300"></div>

          <div id="form-success" hidden class="p-4 mb-6 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-sm text-emerald-300 flex items-center gap-2.5">
            <CircleCheck class="w-5 h-5 text-emerald-400 shrink-0" />
            <span>Your inquiry was submitted successfully. I will get back to you shortly!</span>
          </div>

          <form id="contact-form" class="space-y-5" novalidate>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class={labelCls}>Your Name <span class="text-blue-400">*</span></label>
                <input type="text" id="name" name="name" placeholder="e.g. Alex Morgan" required class={`${inputBase} px-4 py-2.5`} />
              </div>
              <div>
                <label for="email" class={labelCls}>Email Address <span class="text-blue-400">*</span></label>
                <input type="email" id="email" name="email" placeholder="alex@company.com" required class={`${inputBase} px-4 py-2.5`} />
              </div>
            </div>

            <div>
              <label for="message" class={labelCls}>Message / Project Details <span class="text-blue-400">*</span></label>
              <textarea
                id="message"
                name="message"
                rows="5"
                placeholder="Describe your project, role scope, timeline, or question..."
                required
                class={`${inputBase} px-4 py-3 resize-y min-h-[120px]`}
              ></textarea>
            </div>

            <button
              id="submit-btn"
              type="submit"
              class="btn-primary-action w-full py-3 rounded-lg text-sm font-semibold flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50"
            >
              <span class="submit-idle flex items-center gap-2">
                <span>Transmit Message</span>
                <Send class="w-4 h-4" />
              </span>
              <span class="submit-busy hidden">Sending Inquiry...</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const errorBox = document.getElementById('form-error')!;
  const successBox = document.getElementById('form-success')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const copyBtn = document.getElementById('copy-email') as HTMLButtonElement;

  function showError(msg: string) {
    errorBox.textContent = msg;
    errorBox.hidden = !msg;
  }

  function setBusy(busy: boolean) {
    submitBtn.disabled = busy;
    submitBtn.querySelector('.submit-idle')!.classList.toggle('hidden', busy);
    submitBtn.querySelector('.submit-busy')!.classList.toggle('hidden', !busy);
  }

  form.addEventListener('input', () => showError(''));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const payload = { name: data.name ?? '', email: data.email ?? '', message: data.message ?? '' };

    if (!payload.name.trim() || !payload.email.trim() || !payload.message.trim()) {
      return showError('Please complete all fields before sending.');
    }
    if (!/\S+@\S+\.\S+/.test(payload.email)) {
      return showError('Please enter a valid email address.');
    }

    setBusy(true);
    showError('');
    try {
      const response = await fetch('/api/send-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Failed to dispatch message.');

      form.reset();
      successBox.hidden = false;
      setTimeout(() => (successBox.hidden = true), 6000);
    } catch (err: any) {
      showError(err.message || 'Unable to deliver message at this time. Please use direct email.');
    } finally {
      setBusy(false);
    }
  });

  let copyTimer: ReturnType<typeof setTimeout>;
  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(copyBtn.dataset.email!);
    const idle = copyBtn.querySelector('.copy-idle')!;
    const done = copyBtn.querySelector('.copy-done')!;
    idle.classList.add('hidden');
    done.classList.replace('hidden', 'flex');
    clearTimeout(copyTimer);
    copyTimer = setTimeout(() => {
      idle.classList.remove('hidden');
      done.classList.replace('flex', 'hidden');
    }, 2500);
  });
</script>

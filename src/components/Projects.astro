---
import { ExternalLink, Server, Layers, Database, Monitor, CircleCheckBig, X, CodeXml as Code2, Car, ShieldAlert, ArrowUpRight } from '@lucide/astro';
import Github from './icons/Github.astro';
import { projects } from '../data/projects';

const filters = ['All', 'Full Stack', 'Backend', 'Frontend', 'Desktop App', 'Graphics'] as const;
const icons: Record<string, typeof Code2> = { ShieldAlert, Car, Server, Monitor, Database, Layers };
---

<section id="work" class="py-14 md:py-24 border-b border-white/[0.08] relative">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 md:mb-12">
      <div class="max-w-xl space-y-2">
        <div class="text-xs font-mono uppercase tracking-wider text-blue-400 font-semibold">Selected Engineering Work</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Featured Systems &amp; Applications</h2>
        <p class="text-sm text-slate-300 leading-relaxed font-normal">
          A curated collection of production platforms, distributed microservices, and client architectures.
        </p>
      </div>

      <div id="project-filters" class="flex items-center gap-1 p-1 bg-white/[0.04] border border-white/[0.08] rounded-lg overflow-x-auto hide-scrollbar shrink-0">
        {filters.map((filter) => (
          <button
            data-filter={filter}
            data-active={filter === 'All' ? 'true' : 'false'}
            class="px-3 py-1.5 rounded-md text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer text-slate-300 hover:text-white hover:bg-white/[0.05] data-[active=true]:bg-blue-600 data-[active=true]:text-white data-[active=true]:shadow-sm"
          >
            {filter}
          </button>
        ))}
      </div>
    </div>

    <!-- Grid: featured cards span 2 columns only while the "All" filter is active -->
    <div id="project-grid" data-filter="All" class="group/grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project, idx) => {
        const Icon = icons[project.icon] ?? Code2;
        return (
          <article
            data-project={project.id}
            data-category={project.category}
            tabindex="0"
            role="button"
            aria-label={`View details: ${project.title}`}
            class:list={[
              'reveal surface-card surface-card-hover rounded-xl overflow-hidden flex flex-col justify-between cursor-pointer border border-white/[0.08] group focus:outline-none focus-visible:border-blue-400',
              project.featured
                ? 'col-span-1 group-data-[filter=All]/grid:md:col-span-2 group-data-[filter=All]/grid:lg:col-span-2'
                : 'col-span-1',
            ]}
            style={`--d: ${(idx % 3) * 80}ms`}
          >
            <div
              class:list={[
                'relative w-full overflow-hidden bg-slate-950 border-b border-white/[0.06] h-48',
                project.featured && 'group-data-[filter=All]/grid:h-64 group-data-[filter=All]/grid:sm:h-72',
              ]}
            >
              {project.imageUrl ? (
                <img
                  src={project.imageUrl}
                  alt={project.title}
                  loading="lazy"
                  class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-500"
                  referrerpolicy="no-referrer"
                />
              ) : (
                <div class="w-full h-full p-6 flex flex-col justify-between bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 border-b border-white/[0.06] relative overflow-hidden">
                  <div class="absolute inset-0 bg-grid-pattern opacity-40"></div>
                  <div class="flex items-center justify-between relative z-10">
                    <div class="flex items-center gap-2 text-xs font-mono text-slate-400">
                      <Icon class="w-4 h-4 text-blue-400" />
                      <span>{project.category}</span>
                    </div>
                    <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400">{project.tags[0]}</span>
                  </div>
                  <div class="relative z-10">
                    <div class="w-12 h-1 rounded bg-blue-500/40 mb-3"></div>
                    <h4 class="text-white text-base font-bold font-mono tracking-tight">{project.title}</h4>
                  </div>
                </div>
              )}

              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>

              <div class="absolute top-3 left-3 text-xs font-mono font-medium text-slate-300 bg-slate-950/85 px-2.5 py-1 rounded backdrop-blur-md border border-white/[0.08]">
                {project.category}
              </div>

              <div class="absolute top-3 right-3 w-7 h-7 rounded-md bg-slate-950/80 border border-white/[0.1] flex items-center justify-center text-slate-300 group-hover:text-white group-hover:border-blue-400 transition-colors">
                <ArrowUpRight class="w-4 h-4" />
              </div>
            </div>

            <div class="p-6 flex flex-col flex-grow justify-between">
              <div>
                <div class="flex items-start justify-between gap-3 mb-2">
                  <h3 class="text-lg font-bold text-white group-hover:text-blue-400 transition-colors tracking-tight leading-snug">
                    {project.title}
                  </h3>
                </div>
                <p class="text-sm text-slate-300 leading-relaxed font-normal mb-5 line-clamp-3">{project.description}</p>
              </div>

              <div>
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-mono text-slate-400 pt-4 border-t border-white/[0.06]">
                  {project.tags.slice(0, 5).map((tag, i) => (
                    <span class="flex items-center gap-2">
                      <span class="hover:text-slate-200 transition-colors">{tag}</span>
                      {i < Math.min(project.tags.length - 1, 4) && <span aria-hidden="true" class="text-slate-700">·</span>}
                    </span>
                  ))}
                </div>

                <div class="flex items-center gap-4 pt-4 mt-2">
                  {project.demoUrl && (
                    <a
                      href={project.demoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-stop
                      class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-400 hover:text-blue-300 transition-colors"
                    >
                      <ExternalLink class="w-3.5 h-3.5" />
                      <span>Live Platform</span>
                    </a>
                  )}
                  {project.githubUrl && (
                    <a
                      href={project.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-stop
                      class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-300 hover:text-white transition-colors"
                    >
                      <Github class="w-3.5 h-3.5" />
                      <span>Source Code</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <!-- Modal bodies: one server-rendered template per project, cloned into the dialog on open -->
  {projects.map((project) => (
    <template id={`modal-${project.id}`}>
      <div class="flex items-start justify-between gap-4 border-b border-white/[0.08] pb-4">
        <div>
          <div class="text-xs font-mono uppercase tracking-wider text-blue-400 mb-1">{project.category} · Case Study Details</div>
          <h3 id="project-modal-title" class="text-2xl font-bold text-white tracking-tight">{project.title}</h3>
        </div>
        <button
          data-close-modal
          class="p-2 rounded-lg bg-white/[0.05] hover:bg-white/[0.1] text-slate-300 hover:text-white transition-colors cursor-pointer"
          aria-label="Close modal"
        >
          <X class="w-5 h-5" />
        </button>
      </div>

      {project.imageUrl && (
        <div class="rounded-xl overflow-hidden aspect-video bg-slate-950 border border-white/[0.08]">
          <img src={project.imageUrl} alt={project.title} class="w-full h-full object-cover" referrerpolicy="no-referrer" />
        </div>
      )}

      {project.problem ? (
        <div class="space-y-5">
          <div class="p-4 sm:p-5 rounded-xl bg-amber-500/[0.04] border border-amber-500/20 space-y-2">
            <h4 class="text-xs font-mono uppercase tracking-wider text-amber-400 font-bold flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
              The Problem
            </h4>
            <p class="text-sm sm:text-base text-slate-200 leading-relaxed font-normal">{project.problem}</p>
          </div>

          {project.solution && (
            <div class="p-4 sm:p-5 rounded-xl bg-blue-500/[0.04] border border-blue-500/20 space-y-2">
              <h4 class="text-xs font-mono uppercase tracking-wider text-blue-400 font-bold flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
                The Solution
              </h4>
              <p class="text-sm sm:text-base text-slate-200 leading-relaxed font-normal">{project.solution}</p>
            </div>
          )}
        </div>
      ) : (
        <div class="space-y-3">
          <h4 class="text-xs font-mono uppercase tracking-wider text-slate-400 font-semibold">Overview &amp; Implementation</h4>
          <p class="text-base text-slate-200 leading-relaxed font-normal">{project.description}</p>
        </div>
      )}

      {project.highlights && project.highlights.length > 0 && (
        <div class="space-y-3">
          <h4 class="text-xs font-mono uppercase tracking-wider text-slate-400 font-semibold">
            {project.problem ? 'Key Features of the Build' : 'Key Engineering Achievements'}
          </h4>
          <ul class="space-y-2.5">
            {project.highlights.map((h) => (
              <li class="flex items-start gap-2.5 text-sm text-slate-300">
                <CircleCheckBig class="w-4 h-4 text-blue-400 shrink-0 mt-0.5" />
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {project.architecture && (
        <div class="p-4 rounded-xl bg-blue-950/20 border border-blue-500/20 text-xs text-blue-200 space-y-1.5">
          <span class="font-mono uppercase font-bold text-blue-400 block tracking-wider">Tech Stack &amp; Architecture</span>
          <p class="leading-relaxed">{project.architecture}</p>
        </div>
      )}

      <div class="space-y-2">
        <h4 class="text-xs font-mono uppercase tracking-wider text-slate-400 font-semibold">Technology Stack</h4>
        <div class="flex flex-wrap gap-2">
          {project.tags.map((tag) => (
            <span class="px-3 py-1 text-xs font-mono text-slate-300 bg-white/[0.04] border border-white/[0.08] rounded-md">{tag}</span>
          ))}
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-white/[0.08]">
        {project.demoUrl && (
          <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="btn-primary-action px-5 py-2.5 rounded-lg text-sm font-semibold flex items-center gap-2">
            <span>Visit Live Platform</span>
            <ExternalLink class="w-4 h-4" />
          </a>
        )}
        {project.githubUrl && (
          <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary-action px-5 py-2.5 rounded-lg text-sm font-semibold flex items-center gap-2">
            <Github class="w-4 h-4" />
            <span>View GitHub Repository</span>
          </a>
        )}
        <button data-close-modal class="ml-auto text-xs font-mono text-slate-400 hover:text-white px-3 py-2 cursor-pointer">Close (ESC)</button>
      </div>
    </template>
  ))}

  <!-- Modal shell -->
  <div id="project-modal" hidden class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 md:p-8" role="dialog" aria-modal="true" aria-labelledby="project-modal-title">
    <div data-close-modal class="absolute inset-0 bg-black/80 backdrop-blur-md modal-fade"></div>
    <div
      id="project-modal-body"
      class="modal-pop relative w-full max-w-3xl max-h-[90vh] overflow-y-auto hide-scrollbar rounded-2xl bg-[#0B101D] border border-white/[0.12] shadow-2xl p-6 sm:p-8 z-10 space-y-6"
    ></div>
  </div>
</section>

<style is:global>
  @keyframes modal-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes modal-pop { from { opacity: 0; transform: translateY(12px) scale(0.95); } to { opacity: 1; transform: none; } }
  .modal-fade { animation: modal-fade 0.25s ease-out; }
  .modal-pop { animation: modal-pop 0.25s ease-out; }
</style>

<script>
  const grid = document.getElementById('project-grid')!;
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('#project-filters [data-filter]');
  const cards = grid.querySelectorAll<HTMLElement>('[data-project]');
  const modal = document.getElementById('project-modal')!;
  const modalBody = document.getElementById('project-modal-body')!;
  let lastFocused: HTMLElement | null = null;

  // Filtering
  filterButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!;
      grid.dataset.filter = filter;
      filterButtons.forEach((b) => (b.dataset.active = String(b === btn)));
      cards.forEach((card) => {
        card.hidden = filter !== 'All' && card.dataset.category !== filter;
      });
    }),
  );

  // Modal
  function openModal(id: string) {
    const tpl = document.getElementById(`modal-${id}`) as HTMLTemplateElement | null;
    if (!tpl) return;
    lastFocused = document.activeElement as HTMLElement | null;
    modalBody.replaceChildren(tpl.content.cloneNode(true));
    modalBody.scrollTop = 0;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    modalBody.querySelector<HTMLElement>('[data-close-modal]')?.focus();
  }

  function closeModal() {
    if (modal.hidden) return;
    modal.hidden = true;
    modalBody.replaceChildren();
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  grid.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('[data-stop]')) return; // demo / source links keep their own behaviour
    const card = target.closest<HTMLElement>('[data-project]');
    if (card) openModal(card.dataset.project!);
  });

  grid.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const target = e.target as HTMLElement;
    if (!target.matches('[data-project]')) return;
    e.preventDefault();
    openModal(target.dataset.project!);
  });

  modal.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-close-modal]')) closeModal();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>

---
import { ArrowRight, Download, Mail } from '@lucide/astro';
import Github from './icons/Github.astro';
import Linkedin from './icons/Linkedin.astro';

const roles = [
  'Full Stack Engineer',
  'Backend Architect',
  'Next.js & Node.js Specialist',
  'Distributed Systems Enthusiast',
];

const metrics = [
  { value: '10+', label: 'Delivered Projects', caption: 'Full-stack & enterprise apps' },
  { value: '1+ Yr', label: 'Engineering Experience', caption: 'Startup & agency roles' },
  { value: '6+', label: 'Core Tech Stacks', caption: 'React, Next.js, Node, Nest, SQL' },
  { value: '4', label: 'Verified Certifications', caption: 'Data analysis & cloud systems' },
];
---

<section id="hero" class="relative pt-12 pb-14 md:pb-20 border-b border-white/[0.08] overflow-hidden">
  <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-blue-600/10 blur-[130px] rounded-full pointer-events-none -z-10"></div>
  <div class="absolute top-40 right-10 w-[350px] h-[250px] bg-indigo-500/5 blur-[100px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Left column -->
      <div class="lg:col-span-7 space-y-6 enter-up">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-slate-400">
          <span class="text-blue-400 font-semibold">Available for Roles</span>
          <span aria-hidden="true" class="text-slate-600">·</span>
          <span>Full Stack Software Engineer</span>
          <span aria-hidden="true" class="text-slate-600">·</span>
          <span>Dhaka, Bangladesh</span>
        </div>

        <h1
          class="text-3xl sm:text-5xl lg:text-[3.5rem] font-extrabold text-white tracking-tight leading-[1.12]"
          style="text-wrap: balance"
        >
          I build web apps, and the backends behind them.
        </h1>

        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-lg sm:text-xl font-medium text-slate-300">
          <span class="text-slate-400 whitespace-nowrap">Specializing in</span>
          <span class="font-mono text-blue-400 font-semibold tracking-tight">
            <span id="typewriter" data-roles={JSON.stringify(roles)}></span><span class="animate-pulse text-blue-300 font-normal">|</span>
          </span>
        </div>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl font-normal">
          I am <strong class="text-white font-medium">Md. Abdullah Shishir</strong>, a software developer
          focused on building high-performance backend microservices, clean REST APIs, and responsive,
          accessible web applications with Next.js, TypeScript, NestJS, and PostgreSQL.
        </p>

        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 sm:gap-4 pt-2">
          <a
            href="#work"
            class="btn-primary-action px-6 py-3 rounded-lg text-sm font-semibold flex items-center justify-center gap-2 cursor-pointer shadow-sm"
          >
            <span>Explore Featured Work</span>
            <ArrowRight class="w-4 h-4" />
          </a>

          <button
            data-download-cv
            class="btn-secondary-action px-6 py-3 rounded-lg text-sm font-semibold flex items-center justify-center gap-2 cursor-pointer"
          >
            <Download class="w-4 h-4 text-blue-400" />
            <span>Download Resume (PDF)</span>
          </button>
        </div>

        <div class="pt-4 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-slate-400 border-t border-white/[0.06]">
          <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Connect:</span>
          <a href="https://github.com/shishir786" target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors flex items-center gap-1.5">
            <Github class="w-4 h-4" />
            <span class="text-xs font-medium">GitHub</span>
          </a>
          <span aria-hidden="true" class="text-slate-700 hidden sm:inline">·</span>
          <a href="https://linkedin.com/in/abdullah-shishir" target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors flex items-center gap-1.5">
            <Linkedin class="w-4 h-4" />
            <span class="text-xs font-medium">LinkedIn</span>
          </a>
          <span aria-hidden="true" class="text-slate-700 hidden sm:inline">·</span>
          <a href="mailto:abdullahshishir786@gmail.com" class="hover:text-blue-400 transition-colors flex items-center gap-1.5 min-w-0">
            <Mail class="w-4 h-4" />
            <span class="text-xs font-medium break-all">abdullahshishir786@gmail.com</span>
          </a>
        </div>
      </div>

      <!-- Right column: profile card -->
      <div class="lg:col-span-5 flex justify-center enter-scale" style="--d: 150ms">
        <div class="relative w-full max-w-sm">
          <div class="relative p-3 rounded-2xl bg-gradient-to-b from-slate-800/80 to-slate-900/90 border border-white/[0.12] shadow-2xl backdrop-blur-xl">
            <div class="flex items-center justify-between px-3 py-2 border-b border-white/[0.08] mb-3">
              <div class="flex items-center gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-slate-700"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-slate-700"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-slate-700"></div>
              </div>
              <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider">developer.id // shishir786</span>
            </div>

            <div class="relative aspect-[4/5] rounded-xl overflow-hidden bg-slate-950 border border-white/[0.08]">
              <img
                src="/profile.jpg"
                alt="Md. Abdullah Shishir portrait"
                class="w-full h-full object-cover object-top hover:scale-[1.02] transition-transform duration-700"
                referrerpolicy="no-referrer"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4">
                <p class="text-white text-base font-bold tracking-tight">Md. Abdullah Shishir</p>
                <p class="text-blue-300 text-xs font-medium">B.Sc. in Computer Science &amp; Engineering (AIUB)</p>
              </div>
            </div>

            <div class="mt-3 grid grid-cols-2 gap-2 text-xs">
              <div class="p-2.5 rounded-lg bg-white/[0.03] border border-white/[0.06]">
                <div class="text-[10px] font-mono uppercase text-slate-400">Current Role</div>
                <div class="font-semibold text-slate-200 mt-0.5">Jr. Full Stack Engineer</div>
              </div>
              <div class="p-2.5 rounded-lg bg-white/[0.03] border border-white/[0.06]">
                <div class="text-[10px] font-mono uppercase text-slate-400">Core Stack</div>
                <div class="font-semibold text-slate-200 mt-0.5">Next.js · NestJS · SQL</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Metric strip -->
    <div class="mt-16 pt-10 border-t border-white/[0.08] grid grid-cols-2 md:grid-cols-4 gap-6 lg:gap-8">
      {metrics.map((metric, idx) => (
        <div
          class="enter-up p-5 rounded-xl surface-card border border-white/[0.06] hover:border-white/[0.12] transition-colors"
          style={`--d: ${200 + idx * 80}ms`}
        >
          <div class="text-3xl lg:text-4xl font-extrabold text-blue-400 font-mono tabular-numbers tracking-tight">{metric.value}</div>
          <div class="text-sm font-bold text-white mt-1.5">{metric.label}</div>
          <div class="text-xs text-slate-400 mt-0.5 font-normal">{metric.caption}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Typewriter for the rotating role title.
  const el = document.getElementById('typewriter');
  if (el) {
    const roles: string[] = JSON.parse(el.dataset.roles ?? '[]');
    let roleIndex = 0;
    let text = '';
    let deleting = false;

    const tick = () => {
      const role = roles[roleIndex];
      let delay: number;
      if (!deleting) {
        if (text !== role) {
          text = role.slice(0, text.length + 1);
          delay = 80;
        } else {
          deleting = true;
          delay = 2200;
        }
      } else if (text !== '') {
        text = role.slice(0, text.length - 1);
        delay = 40;
      } else {
        deleting = false;
        roleIndex = (roleIndex + 1) % roles.length;
        delay = 80;
      }
      el.textContent = text;
      setTimeout(tick, delay);
    };

    // Start from an empty string, as the original did.
    el.textContent = '';
    tick();
  }
</script>

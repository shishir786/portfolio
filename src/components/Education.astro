---
import { GraduationCap, Calendar, MapPin } from '@lucide/astro';
import { educationItems } from '../data/education';
---

<section id="education" class="py-14 md:py-24 border-b border-white/[0.08] relative">
  <div class="max-w-7xl mx-auto px-6">
    <div class="max-w-xl mb-8 md:mb-14 space-y-2">
      <div class="text-xs font-mono uppercase tracking-wider text-blue-400 font-semibold">Academic Background</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Education &amp; Credentials</h2>
      <p class="text-sm text-slate-300 leading-relaxed font-normal">
        Formal computer science training and academic qualifications that underpin my software development career.
      </p>
    </div>

    <div class="max-w-4xl space-y-8">
      {educationItems.map((item, idx) => (
        <div class="reveal p-6 sm:p-8 rounded-xl surface-card surface-card-hover border border-white/[0.08]" style={`--d: ${idx * 100}ms`}>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/[0.06] pb-4 mb-5">
            <div>
              <h3 class="text-lg sm:text-xl font-bold text-white tracking-tight flex items-center gap-2.5">
                <GraduationCap class="w-5 h-5 text-blue-400 shrink-0" />
                <span>{item.roleOrDegree}</span>
              </h3>
              <div class="flex items-center gap-2 text-sm text-blue-400 font-medium mt-1">
                <span>{item.organization}</span>
                {item.location && (
                  <>
                    <span aria-hidden="true" class="text-slate-600">·</span>
                    <span class="text-xs text-slate-400 flex items-center gap-1">
                      <MapPin class="w-3 h-3 text-slate-400" />
                      {item.location}
                    </span>
                  </>
                )}
              </div>
            </div>

            <div class="flex items-center gap-1.5 text-xs font-mono tabular-numbers text-slate-300 bg-white/[0.04] border border-white/[0.08] px-3 py-1.5 rounded-md shrink-0">
              <Calendar class="w-3.5 h-3.5 text-blue-400" />
              <span>{item.period}</span>
            </div>
          </div>

          <p class="text-sm text-slate-300 leading-relaxed font-normal mb-4">{item.description}</p>

          {item.highlights && (
            <ul class="space-y-1.5 pt-2 border-t border-white/[0.04]">
              {item.highlights.map((h) => (
                <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-300">
                  <span class="w-1.5 h-1.5 rounded-full bg-blue-400 shrink-0 mt-2"></span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
